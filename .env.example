# Upstream Zendesk (laptop mode: on the developer machine; VM mode: only on the VM)
ZSAN_ZENDESK_SUBDOMAIN=
ZSAN_ZENDESK_EMAIL=
ZSAN_ZENDESK_API_TOKEN=
ZSAN_UPSTREAM_COMMAND=npx -y @sshadows/zendesk-mcp-server@1.4.1

# Sidecars
ZSAN_PRESIDIO_URL=http://127.0.0.1:5002
# required | off (off is logged loudly and is Presidio-only — no pass-2 detector runs).
ZSAN_PASS2=required
# gliner | ollama
ZSAN_PASS2_DETECTOR=gliner
# GLiNER pass-2 sidecar (required when ZSAN_PASS2=required)
ZSAN_GLINER_URL=http://127.0.0.1:5003
# Pinned model identity the proxy verifies at startup
ZSAN_GLINER_MODEL_REF=urchade/gliner_multi_pii-v1@1fcf13e85f4eef5394e1fcd406cf2ca9ea82351d
# Labels / threshold / entity map (CODEOWNERS-owned)
ZSAN_GLINER_CONFIG_PATH=config/gliner.json

# Tuning
ZSAN_PRESIDIO_TIMEOUT_MS=15000
ZSAN_PASS2_TIMEOUT_MS=20000
ZSAN_CHUNK_MAX_CHARS=6000
ZSAN_CONCURRENCY=4
ZSAN_LOG_LEVEL=info
ZSAN_ALLOWLIST_PATH=config/allowlist.txt
ZSAN_RECOGNIZERS_PATH=config/recognizers

# Transport (VM mode)
# stdio | http — http requires ZSAN_CLIENT_TOKENS
ZSAN_TRANSPORT=stdio
ZSAN_HTTP_PORT=8080
# Per-developer bearer tokens: name:token,name:token
ZSAN_CLIENT_TOKENS=
